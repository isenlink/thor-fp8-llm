@@ -360,6 +360,39 @@ static __device__ __forceinline__ float vec_dot_nvfp4_q8_1(
 
     return sum;
 }
+
+// [B3] Preloaded-y variant of vec_dot_nvfp4_q8_1: the y slice is already in registers
+// (y_pre[8] = 8 ints of one q8_1 block's qs, y_ds = that block's d), reused across rows.
+// Only reads the weight block. Eliminates the per-row re-read of y (y L2 traffic /rows_per_block).
+static __device__ __forceinline__ float vec_dot_nvfp4_q8_1_preload(
+                                        const void * __restrict__ vbq,
+                                        const int * __restrict__ y_pre,
+                                        const float & y_ds,
+                                        const int32_t & kbx,
+                                        const int32_t & iqs) {
+
+    const block_nvfp4 * bq4 = (const block_nvfp4 *) vbq + kbx;
+    float sum = 0.0f;
+#pragma unroll
+    for (int i = 0; i < VDR_NVFP4_Q8_1_MMVQ/2; i++) {
+        const int32_t iqs0 = iqs + 2*i;
+        const int32_t iqs1 = iqs0 + 1;
+        const int32_t is = iqs0 >> 1;
+        const int2 v0 = get_int_from_table_16(get_int_b4(bq4->qs, iqs0), kvalues_mxfp4);
+        const int2 v1 = get_int_from_table_16(get_int_b4(bq4->qs, iqs1), kvalues_mxfp4);
+        const int32_t i8 = ((is & 1) << 2);
+
+        int sumi = ggml_cuda_dp4a(v0.x, y_pre[i8 + 0], 0);
+        sumi = ggml_cuda_dp4a(v0.y, y_pre[i8 + 2], sumi);
+        sumi = ggml_cuda_dp4a(v1.x, y_pre[i8 + 1], sumi);
+        sumi = ggml_cuda_dp4a(v1.y, y_pre[i8 + 3], sumi);
+
+        const float d = ggml_cuda_ue4m3_to_fp32(bq4->d[is]) * y_ds;
+        sum += d * float(sumi);
+    }
+
+    return sum;
+}
 #define VDR_Q2_K_Q8_1_MMVQ 1
 #define VDR_Q2_K_Q8_1_MMQ  4
 
