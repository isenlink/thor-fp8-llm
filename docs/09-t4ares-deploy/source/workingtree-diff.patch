+// Card 40 (O10, 20260915-40): native q8_0 K/V loader for the MMA FA kernel.
+//
+// Reads the q8_0 blocks straight from gmem and writes the *dequantized* f16 tile in exactly the
+// same layout (including the smem swizzle map) that flash_attn_ext_f16_load_tile produces for f16
+// K/V data => the MMA main loop below is unchanged. This is what lets the MMA path skip the
+// "convert the whole K/V cache to f16" scratch buffer (fattn.cu: need_f16_K/V = false).
+//
+// Only used for DKQ == DV == 128, ncols2 == 1 (=> nstages == 0, single stage, synchronous) and
+// M in [3,16]; the caller guarantees the full-width row invariant (nbatch_K2 == DKQ/2 etc.).
+// The byte stride of one KV row is passed as -stride_K*2-style negative value from the kernel,
+// see the stride_K/stride_V definition in flash_attn_ext_f16.
+template<int stride_tile, bool swz, int nwarps, int nbatch_fa, bool oob_check>
+static __device__ __forceinline__ void flash_attn_ext_f16_load_tile_q8_0(
+        const char * const __restrict__ KV_q8, half2 * const __restrict__ tile_KV,
+        const int D2, const int stride_KV_bytes, const int k_VKQ_0, const int i_sup) {
+    constexpr int warp_size  = ggml_cuda_get_physical_warp_size();
+    constexpr int h2_per_blk = QK8_0/2; // 16 half2 = 32 elements = one q8_0 block
+    const int blocks_per_row = D2 / h2_per_blk;
+
+    for (int blk = threadIdx.y*warp_size + threadIdx.x; blk < nbatch_fa*blocks_per_row; blk += nwarps*warp_size) {
+        const int i  = blk / blocks_per_row; // KV row inside the tile
+        const int b  = blk % blocks_per_row; // q8_0 block inside the row
+        const int k0 = b*h2_per_blk;         // first half2 column of that block
+
+        half2 v[h2_per_blk];
+        if (!oob_check || i < i_sup) {
+            const block_q8_0 * x = (const block_q8_0 *) (KV_q8 +
+                (int64_t)(k_VKQ_0 + i)*stride_KV_bytes + b*(int) sizeof(block_q8_0));
+            const float d = x->d;
+#pragma unroll
+            for (int j = 0; j < h2_per_blk; ++j) {
+                v[j] = make_half2(d*x->qs[2*j + 0], d*x->qs[2*j + 1]);
+            }
+        } else {
+#pragma unroll
+            for (int j = 0; j < h2_per_blk; ++j) {
+                v[j] = make_half2(0.0f, 0.0f);
+            }
+        }
+
+#pragma unroll
+        for (int j = 0; j < h2_per_blk; ++j) {
+            if constexpr (swz) {
+                *(half2 *) ((char *) tile_KV + ggml_cuda_fattn_smem_swizzle::bytes_rc<stride_tile>(i, k0 + j)) = v[j];
+            } else {
+                tile_KV[i*stride_tile + k0 + j] = v[j];
+            }
+        }
+    }
+}
