+// [B4] NVFP4 wide-M kernel for MTP verify batches (M=3..16).
+// MMQ at M=13 measures only ~80-97 GB/s on Thor (sm_101a) while MMVQ M=1 reaches
+// ~230 GB/s. The generic MMVQ multi-column path re-reads + re-LUT-decodes the
+// weight block once per column, decaying to ~82 GB/s at M=8. This kernel loads
+// each weight block into registers once and LUT-decodes once, then dp4a's it
+// against all M columns' q8_1 y (re-read per column from L1/L2, y is small).
+template <int ncols_dst, int rows_per_block, int nwarps>
+__launch_bounds__(nwarps*32, 1)
+static __global__ void mul_mat_vec_q_nvfp4_wide(
+        const void * __restrict__ vx, const void * __restrict__ vy, float * __restrict__ dst,
+        const uint32_t ncols_x, const uint32_t nrows_x,
+        const uint32_t stride_row_x, const uint32_t stride_col_y, const uint32_t stride_col_dst) {
+
+    constexpr int qk = QK_NVFP4; // 64 values per block
+    const int tid = 32*threadIdx.y + threadIdx.x;
+    const int row0 = rows_per_block*blockIdx.x;
+    const int blocks_per_row_x = ncols_x / qk;
+    constexpr int blocks_per_iter = 16*nwarps; // vdr*nwarps*warp_size/qi = 4*nwarps*32/8
+
+    const int t2  = tid % 2; // half-block selector (qi/vdr == 2)
+    const int kqs = 4*t2;    // this thread's first qs int32 index
+
+    float tmp[ncols_dst][rows_per_block] = {};
+
+    const block_q8_1 * y = (const block_q8_1 *) vy;
+
+    for (int kbx = tid/2; kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * 2; // q8_1 block index aligned with kbx (QK_NVFP4/QK8_1 = 2)
+
+        // load + LUT-decode this thread's weight slice once, reuse across columns
+        int  v[rows_per_block][8];
+        float wd[rows_per_block][2];
+#pragma unroll
+        for (int i = 0; i < rows_per_block; ++i) {
+            const block_nvfp4 * bq4 = (const block_nvfp4 *) vx + (size_t)(row0 + i)*stride_row_x + kbx;
+            const int2 p0 = get_int_from_table_16(get_int_b4(bq4->qs, kqs + 0), kvalues_mxfp4);
+            const int2 p1 = get_int_from_table_16(get_int_b4(bq4->qs, kqs + 1), kvalues_mxfp4);
+            const int2 p2 = get_int_from_table_16(get_int_b4(bq4->qs, kqs + 2), kvalues_mxfp4);
+            const int2 p3 = get_int_from_table_16(get_int_b4(bq4->qs, kqs + 3), kvalues_mxfp4);
+            // dp4a pairing mirrors vec_dot_nvfp4_q8_1: (p0.x,y[0]) (p0.y,y[2]) (p1.x,y[1]) (p1.y,y[3])
+            v[i][0] = p0.x; v[i][1] = p0.y; v[i][2] = p1.x; v[i][3] = p1.y;
+            v[i][4] = p2.x; v[i][5] = p2.y; v[i][6] = p3.x; v[i][7] = p3.y;
+            wd[i][0] = ggml_cuda_ue4m3_to_fp32(bq4->d[2*t2 + 0]);
+            wd[i][1] = ggml_cuda_ue4m3_to_fp32(bq4->d[2*t2 + 1]);
+        }
+
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+            const block_q8_1 * bq8 = y + j*stride_col_y + kby + t2;
+            // qs is only 4-byte aligned (offset by half2 ds): scalar int loads, no int4
+            int yq[8];
+            {
+                const int * qsy = (const int *) bq8->qs;
+#pragma unroll
+                for (int q = 0; q < 8; ++q) {
+                    yq[q] = qsy[q];
+                }
+            }
+            const float yds = __low2float(bq8->ds);
+
+#pragma unroll
+            for (int i = 0; i < rows_per_block; ++i) {
+                int s0 = ggml_cuda_dp4a(v[i][0], yq[0], 0);
+                s0 = ggml_cuda_dp4a(v[i][1], yq[2], s0);
+                s0 = ggml_cuda_dp4a(v[i][2], yq[1], s0);
+                s0 = ggml_cuda_dp4a(v[i][3], yq[3], s0);
+                int s1 = ggml_cuda_dp4a(v[i][4], yq[4], 0);
+                s1 = ggml_cuda_dp4a(v[i][5], yq[6], s1);
+                s1 = ggml_cuda_dp4a(v[i][6], yq[5], s1);
+                s1 = ggml_cuda_dp4a(v[i][7], yq[7], s1);
+                tmp[j][i] += wd[i][0]*yds*(float) s0 + wd[i][1]*yds*(float) s1;
+            }
+        }
+    }
+
+    __shared__ float tmp_shared[nwarps-1 > 0 ? nwarps-1 : 1][ncols_dst][rows_per_block][32];
+
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+            for (int i = 0; i < rows_per_block; ++i) {
+                tmp_shared[threadIdx.y-1][j][i][threadIdx.x] = tmp[j][i];
+            }
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+
+    dst += row0;
+
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+        for (int i = 0; i < rows_per_block; ++i) {
+#pragma unroll
+            for (int l = 0; l < nwarps-1; ++l) {
+                tmp[j][i] += tmp_shared[l][j][i][threadIdx.x];
+            }
+            tmp[j][i] = warp_reduce_sum<32>(tmp[j][i]);
+            if (threadIdx.x == i && uint32_t(row0 + i) < nrows_x) {
+                dst[j*stride_col_dst + i] = tmp[j][i];
+            }
+        }
+    }
+}
