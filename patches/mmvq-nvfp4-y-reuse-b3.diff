+int ggml_cuda_nvfp4_wide_max_batch() {
+    static int cached = -1;
+    if (cached < 0) {
+        int v = 16; // [B4] default: NVFP4 wide kernel handles M=3..16 (MTP verify)
+        const char * env = getenv("GGML_NVFP4_WIDE_MAX");
+        if (env && atoi(env) >= 0) v = atoi(env);
+        cached = v;
+    }
+    return cached;
+}
+static inline int nvfp4_wide_max_batch() {
+    return ggml_cuda_nvfp4_wide_max_batch();
+}
+
+template <int ncols_dst, int rows_per_block, int nwarps>
+static void launch_mul_mat_vec_q_nvfp4_wide(
+        const void * vx, const void * vy, float * dst,
+        const int ncols_x, const int nrows_x,
+        const int stride_row_x, const int stride_col_y, const int stride_col_dst,
+        cudaStream_t stream) {
+    const dim3 block_dims(32, nwarps);
+    const dim3 block_nums((nrows_x + rows_per_block - 1) / rows_per_block);
+    mul_mat_vec_q_nvfp4_wide<ncols_dst, rows_per_block, nwarps><<<block_nums, block_dims, 0, stream>>>(
+        vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst);
+}
+
+// [B4] config experiments: GGML_NVFP4_WIDE_CFG selects (rows_per_block, nwarps)
+// for M in {8,13}; 0 or unset = (2,4) default for all M.
+static inline int nvfp4_wide_cfg() {
+    static int cached = -1;
+    if (cached < 0) {
+        const char * env = getenv("GGML_NVFP4_WIDE_CFG");
+        cached = env ? atoi(env) : 0;
+    }
+    return cached;
+}
