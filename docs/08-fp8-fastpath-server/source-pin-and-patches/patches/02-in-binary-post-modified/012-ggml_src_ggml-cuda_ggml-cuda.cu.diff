+// [Thor op-prof] graph-level async op timing (zero-sync: record only, resolve at dump)
+// Env GGML_OP_PROF=1. Buckets by op name + tensor-name keyword refinement.
+// Dump: /brand_data/ai_workspace/bench/op_prof.txt every 2000 timed ops.
+#include <unordered_map>
+struct op_prof_ent { uint64_t n = 0; double ms = 0; double flops = 0; };
+static std::unordered_map<std::string, op_prof_ent> g_op_prof;
+static uint64_t g_op_prof_count = 0;
+static bool g_op_prof_on = getenv("GGML_OP_PROF") != nullptr;
+static double g_op_prof_flops_pending = 0.0;
+static cudaEvent_t g_op_ev_a = nullptr, g_op_ev_b = nullptr;
+static bool g_op_last_capture_skipped = false;
+static void op_prof_dump() {
+    FILE * f = fopen("/brand_data/ai_workspace/bench/op_prof.txt", "w");
+    if (!f) return;
+    double total = 0;
+    for (auto & kv : g_op_prof) total += kv.second.ms;
+    fprintf(f, "op profile (n=%llu, total=%.1f ms)\n", (unsigned long long)g_op_prof_count, total);
+    fprintf(f, "%-40s %10s %12s %8s %8s %10s\n", "bucket", "calls", "total_ms", "avg_us", "pct", "TFLOP/s");
+    std::vector<std::pair<std::string, op_prof_ent>> v(g_op_prof.begin(), g_op_prof.end());
+    std::sort(v.begin(), v.end(), [](auto & a, auto & b){ return a.second.ms > b.second.ms; });
+    for (auto & kv : v) {
+        double tflops = kv.second.ms > 0 ? kv.second.flops / (kv.second.ms * 1e-3) / 1e12 : 0.0;
+        fprintf(f, "%-40s %10llu %12.3f %8.1f %7.1f%% %10.2f\n", kv.first.c_str(),
+                (unsigned long long)kv.second.n, kv.second.ms,
+                kv.second.n ? kv.second.ms*1000.0/kv.second.n : 0.0,
+                total > 0 ? kv.second.ms*100.0/total : 0.0, tflops);
+    }
+    fclose(f);
+}
+static void ggml_cuda_op_prof_begin(cudaStream_t st) {
+    if (!g_op_prof_on) return;
+    cudaStreamCaptureStatus cap = cudaStreamCaptureStatusNone;
+    cudaStreamIsCapturing(st, &cap);
+    if (cap != cudaStreamCaptureStatusNone) return;  // no event ops inside capture
+    if (!g_op_ev_a) { cudaEventCreate(&g_op_ev_a); cudaEventCreate(&g_op_ev_b); }
+    g_op_last_capture_skipped = (cap != cudaStreamCaptureStatusNone);
+    cudaEventRecord(g_op_ev_a, st);
+}
+static void ggml_cuda_op_prof_end(cudaStream_t st, const ggml_tensor * node) {
+    if (!g_op_prof_on) return;
+    cudaStreamCaptureStatus cap = cudaStreamCaptureStatusNone;
+    cudaStreamIsCapturing(st, &cap);
+    if (cap != cudaStreamCaptureStatusNone) return;
+    cudaEventRecord(g_op_ev_b, st);
+    cudaEventSynchronize(g_op_ev_b);
+    float ms = 0; cudaEventElapsedTime(&ms, g_op_ev_a, g_op_ev_b);
+    const char * opn = ggml_op_name(node->op);
+    const char * tn = node->name && node->name[0] ? node->name : opn;
+    std::string key = opn;
+    // refine by tensor name keyword — Thor 审计版：lm_head / GDN / attention / ffn 分离
+    std::string n(tn);
+    if (n.find("output") != std::string::npos || n == "MUL_MAT") {
+        // llama.cpp 里 lm_head 的节点名通常是 "result-output" 或含 output
+    }
+    for (auto & kw : {std::string("output"), std::string("result"), std::string("ffn"), std::string("ssm"),
+                      std::string("gdn"), std::string("attn"), std::string("qkv"), std::string("out_proj"),
+                      std::string("alpha"), std::string("beta"), std::string("conv")}) {
+        if (n.find(kw) != std::string::npos) { key += ":" + kw; break; }
+    }
+    if (strstr(opn, "MUL_MAT") && node->src[0]) {
+        if (node->src[0]->type == GGML_TYPE_F8_E4M3) key += ":F8";
+        else if (node->src[0]->type == GGML_TYPE_NVFP4) key += ":NVFP4";
+        else if (node->src[0]->type == GGML_TYPE_BF16 || node->src[0]->type == GGML_TYPE_F16) key += ":BF16";
+        // N 维度（权重输出维）：区分瘦 GEMM（N=48 门控）vs 宽 GEMM（N=5120/10240/17408）
+        int64_t N = node->src[0]->ne[1];
+        if (N > 100000) key += ":HUGE-N";
+        else key += ":N" + std::to_string(N);
+        // FLOPs = 2 * N * K * M（A=[N,K] 权重, B=[K,M] 激活）
+        if (node->src[1]) {
+            int64_t K = node->src[0]->ne[0];
+            int64_t M = node->src[1]->ne[1];
+            g_op_prof_flops_pending = 2.0 * (double)N * (double)K * (double)M;
+        }
+    }
+    auto & e = g_op_prof[key];
+    e.n += 1; e.ms += ms; e.flops += g_op_prof_flops_pending;
+    g_op_prof_flops_pending = 0.0;
+    if ((++g_op_prof_count) % 20000 == 0) { op_prof_dump(); g_op_prof.clear(); }
+}
