+        const void * vx, const void * vy, float * dst,
+        const int ncols_x, const int nrows_x,
+        const int stride_row_x, const int stride_col_y, const int stride_col_dst,
+        cudaStream_t stream) {
+    const int cfg = nvfp4_wide_cfg();
+    if constexpr (ncols_dst == 8 || ncols_dst == 13) {
+        switch (cfg) {
+            case 1: launch_mul_mat_vec_q_nvfp4_wide<ncols_dst, 1, 4>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); return;
+            case 2: launch_mul_mat_vec_q_nvfp4_wide<ncols_dst, 4, 4>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); return;
+            case 3: launch_mul_mat_vec_q_nvfp4_wide<ncols_dst, 2, 8>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); return;
+            case 4: launch_mul_mat_vec_q_nvfp4_wide<ncols_dst, 4, 2>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); return;
+            case 5: launch_mul_mat_vec_q_nvfp4_wide<ncols_dst, 1, 8>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); return;
+            default: break;
+        }
+    }
+    launch_mul_mat_vec_q_nvfp4_wide<ncols_dst, 2, 4>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream);
+}
