+def _quantize_f8_e4m3(data: np.ndarray) -> np.ndarray:
+    # Thor patch: encode float to FP8 E4M3 bytes.
+    # uint8 input is ALREADY raw FP8 bytes (torch fp8 → numpy view) — pass through untouched.
+    if data.dtype == np.uint8:
+        return data
+    import ml_dtypes
+    return data.astype(ml_dtypes.float8_e4m3fn).view(np.uint8)
+
+
